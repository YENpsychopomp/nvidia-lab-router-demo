# OpenAI-compatible base URL of the LiteLLM proxy (include /v1)
LITELLM_BASE_URL=https://eric51.iai.nkust.edu.tw/uclazure/v1
# LiteLLM key, sent as the x-litellm-api-key header
LITELLM_API_KEY=
# Routing brain (POST {base}/systemone)
BRAIN_MODEL=Microsoft-Decision-1
# Chat model shown in the UI (fixed to auto)
CHAT_MODEL=auto
# Optional separate endpoint for chat. When all three tier models are set,
# auto sends each question to LOW / MID / HIGH according to the routing decision.
LITELLM_CHAT_BASE_URL=
LITELLM_CHAT_API_KEY=
LITELLM_CHAT_MODEL_LOW=
LITELLM_CHAT_MODEL_MID=
LITELLM_CHAT_MODEL_HIGH=
# Optional system prompt for the chat model (leave empty to disable)
# CHAT_SYSTEM_PROMPT=請使用與使用者相同的語言回答。使用者以中文提問時，一律使用繁體中文與台灣用語。
PORT=5180
